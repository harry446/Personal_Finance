generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?     @map("email_verified")
  image         String?
  budgetModeEnabled Boolean @default(false) @map("budget_mode_enabled")
  accounts      Account[]
  budgets       Budget[]
  categories    Category[]
  sessions      Session[]
  transactions  Transaction[]
  importBatches ImportBatch[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id             String                 @id @default(cuid())
  userId         String                 @map("user_id")
  name           String
  normalizedName String                 @map("normalized_name")
  archivedAt     DateTime?              @map("archived_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  candidates     CandidateTransaction[]
  budgets        Budget[]

  @@unique([userId, normalizedName])
  @@index([userId, archivedAt])
  @@map("categories")
}

enum TransactionType {
  EXPENSE @map("expense")
  REFUND  @map("refund")
}

enum TransactionSource {
  MANUAL @map("manual")
  IMPORT @map("import")
}

model Transaction {
  id                String                @id @default(cuid())
  userId            String                @map("user_id")
  categoryId        String                @map("category_id")
  transactionDate   DateTime              @map("transaction_date") @db.Date
  type              TransactionType
  amountCents       Int                   @map("amount_cents")
  description       String
  notes             String?
  source            TransactionSource     @default(MANUAL)
  importBatchId     String?               @map("import_batch_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  importBatch       ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  approvedCandidate CandidateTransaction? @relation("CandidateSavedTransaction")

  @@index([userId, transactionDate])
  @@index([categoryId])
  @@index([importBatchId])
  @@map("transactions")
}

enum ImportBatchStatus {
  PROCESSING       @map("processing")
  READY_FOR_REVIEW @map("ready_for_review")
  APPROVED         @map("approved")
  FAILED           @map("failed")
}

enum CandidateReviewState {
  PENDING  @map("pending")
  SELECTED @map("selected")
  EXCLUDED @map("excluded")
  APPROVED @map("approved")
}

enum ExtractionLogStatus {
  PENDING   @map("pending")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
}

model ImportBatch {
  id                 String                 @id @default(cuid())
  userId             String                 @map("user_id")
  status             ImportBatchStatus      @default(READY_FOR_REVIEW)
  fileCount          Int                    @default(0) @map("file_count")
  candidateCount     Int                    @default(0) @map("candidate_count")
  approvedCount      Int                    @default(0) @map("approved_count")
  model              String
  failureCode        String?                @map("failure_code")
  failureMessageSafe String?                @map("failure_message_safe")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidates         CandidateTransaction[]
  extractionLog      ExtractionLog?
  transactions       Transaction[]

  @@index([userId, createdAt])
  @@map("import_batches")
}

model CandidateTransaction {
  id                    String               @id @default(cuid())
  importBatchId         String               @map("import_batch_id")
  ordinal               Int
  transactionDate       DateTime?            @map("transaction_date") @db.Date
  type                  TransactionType?
  amountCents           Int?                 @map("amount_cents")
  description           String?
  categoryId            String?              @map("category_id")
  notes                 String?
  suggestedCategoryText String?              @map("suggested_category_text")
  reviewState           CandidateReviewState @default(PENDING) @map("review_state")
  savedTransactionId    String?              @unique @map("saved_transaction_id")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  importBatch           ImportBatch          @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  category              Category?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  savedTransaction      Transaction?         @relation("CandidateSavedTransaction", fields: [savedTransactionId], references: [id], onDelete: Restrict)

  @@unique([importBatchId, ordinal])
  @@index([importBatchId, reviewState])
  @@map("candidate_transactions")
}

model ExtractionLog {
  id                  String              @id @default(cuid())
  importBatchId       String              @unique @map("import_batch_id")
  providerRequestId   String?             @map("provider_request_id")
  model               String
  status              ExtractionLogStatus @default(PENDING)
  errorCode           String?             @map("error_code")
  rawOutputCiphertext String?             @map("raw_output_ciphertext") @db.Text
  durationMs          Int                 @map("duration_ms")
  expiresAt           DateTime            @map("expires_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  importBatch         ImportBatch         @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("extraction_logs")
}

enum BudgetMode {
  MONTHLY_RESET @map("monthly_reset")
  ROLLOVER      @map("rollover")
}

model Budget {
  id             String                @id @default(cuid())
  userId         String                @map("user_id")
  categoryId     String                @map("category_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  configurations BudgetConfiguration[]

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@map("budgets")
}

model BudgetConfiguration {
  id             String     @id @default(cuid())
  budgetId       String     @map("budget_id")
  effectiveMonth DateTime   @map("effective_month") @db.Date
  amountCents    Int        @map("amount_cents")
  mode           BudgetMode
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  budget         Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, effectiveMonth])
  @@index([effectiveMonth])
  @@map("budget_configurations")
}
